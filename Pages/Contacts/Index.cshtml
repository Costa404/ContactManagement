@page
@model ContactManagement.Pages.Contacts.IndexModel
@{
    ViewData["Title"] = "Contacts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Contacts</h1>
    <a asp-page="Create" class="btn btn-primary">New Contact</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Contacts)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.ContactNumber</td>
            <td>@item.Email</td>
            <td class="text-end">
                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Edit</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this contact?');">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
